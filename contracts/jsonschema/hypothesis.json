{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsteam.dev/hypothesis.json",
  "title": "Hypothesis",
  "$comment": "A candidate root cause (docs/04 §3.5). Only the RCA Verifier sets assessment != proposed. confidence stays null until calibrated (ADR-0012).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "hypothesis_id", "incident_id", "agent", "description", "category", "entities",
    "evidence_ids", "counterevidence_ids", "assessment", "missing_data"
  ],
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/SchemaVersion" },
    "hypothesis_id": { "$ref": "common.json#/$defs/HypothesisId" },
    "incident_id": { "$ref": "common.json#/$defs/IncidentId" },
    "agent": { "$ref": "common.json#/$defs/AgentName" },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "category": { "$ref": "common.json#/$defs/HypothesisCategory" },
    "entities": { "type": "array", "items": { "type": "string", "maxLength": 256 } },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.json#/$defs/EvidenceId" }
    },
    "counterevidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.json#/$defs/EvidenceId" }
    },
    "assessment": { "type": "string", "enum": ["proposed", "supported", "weakened", "refuted", "inconclusive"] },
    "rank": { "type": "integer", "minimum": 1 },
    "verifier_notes": { "type": "string", "maxLength": 4000 },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "missing_data": { "type": "array", "items": { "type": "string", "maxLength": 256 } }
  }
}
