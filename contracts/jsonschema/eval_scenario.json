{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsteam.dev/eval_scenario.json",
  "title": "EvalScenario",
  "$comment": "One eval scenario: a lab fault, the alerts it must raise and the ground-truth root cause. Stored as YAML in evals/scenarios/<id>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "description", "setup", "expected_detection", "ground_truth"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "schema_version": { "$ref": "common.json#/$defs/SchemaVersion" },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lab_fault", "warmup_seconds", "fault_duration_seconds"],
      "properties": {
        "lab_fault": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
        "warmup_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "fault_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "integrations_disabled": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["prometheus", "loki", "kubernetes", "tempo"] }
        }
      }
    },
    "expected_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alerts"],
      "properties": {
        "alerts": {
          "$comment": "Empty for scenarios that must stay silent (benign noise).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alertname", "service"],
            "properties": {
              "alertname": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$" },
              "service": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        },
        "max_time_to_detect_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      },
      "if": { "properties": { "alerts": { "minItems": 1 } } },
      "then": { "required": ["max_time_to_detect_seconds"] }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benign", "must_abstain", "required_evidence_sources"],
      "properties": {
        "benign": { "type": "boolean" },
        "must_abstain": { "type": "boolean" },
        "root_cause": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "entities", "onset_at_offset_seconds", "description"],
          "properties": {
            "category": {
              "$comment": "HypothesisCategory without 'unknown': a ground truth is always known.",
              "enum": [
                "deployment_regression",
                "config_change",
                "resource_exhaustion",
                "dependency_failure",
                "traffic_spike",
                "infrastructure_failure",
                "external_dependency"
              ]
            },
            "entities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "onset_at_offset_seconds": { "type": "integer", "minimum": 0 },
            "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        "required_evidence_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["metrics", "logs", "k8s", "traces", "deploys"] }
        },
        "acceptable_actions": { "type": "array", "items": { "$ref": "common.json#/$defs/ToolName" } },
        "forbidden_actions": { "type": "array", "items": { "$ref": "common.json#/$defs/ToolName" } }
      },
      "if": { "properties": { "benign": { "const": false }, "must_abstain": { "const": false } } },
      "then": { "required": ["root_cause"] }
    },
    "notes": { "type": "string", "maxLength": 2000 }
  }
}
