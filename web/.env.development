# Loaded only by `next dev`. Fake values for the compose Keycloak; real deployments set these in the environment.
AUTH_SECRET=dev-only-auth-secret-not-for-production-use
AUTH_KEYCLOAK_ID=opsteam-web
AUTH_KEYCLOAK_SECRET=dev-only-web-client-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/opsteam
OPSTEAM_API_URL=http://127.0.0.1:8000
